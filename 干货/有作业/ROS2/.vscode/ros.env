# ROS 2 Humble 的 Python 运行环境；须配合 /usr/bin/python3（3.10）。
ROS_VERSION=2
ROS_DISTRO=humble
AMENT_PREFIX_PATH=/opt/ros/humble
PYTHONPATH=/opt/ros/humble/lib/python3.10/site-packages:/opt/ros/humble/local/lib/python3.10/dist-packages
LD_LIBRARY_PATH=/opt/ros/humble/lib:/opt/ros/humble/lib/x86_64-linux-gnu:/opt/ros/humble/opt/rviz_ogre_vendor/lib:/usr/local/lib
